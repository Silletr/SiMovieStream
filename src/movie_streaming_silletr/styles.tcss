#result-card {
    background: #1a1a1a;
    border: tall #7c3aed;
    padding: 1 2;
    margin-top: 1;
    height: auto;
}

#title {
    text-style: bold;
    color: #ffffff;
    margin-bottom: 1;
}

#genres {
    color: #7c3aed;
    text-style: italic;
}

#description {
    color: #a0a0a0;
    margin-top: 1;
}

#url {
    color: #e50914;
    margin-top: 1;
}
